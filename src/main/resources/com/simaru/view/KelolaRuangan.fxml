<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.simaru.controller.KelolaRuanganController">

    <padding>
        <Insets bottom="16" left="16" right="16" top="16"/>
    </padding>

    <Label styleClass="judul" text="Kelola Ruangan"/>

    <Label text="Manajemen data ruangan SIMARU"/>

    <HBox alignment="CENTER_LEFT" spacing="10">

        <TextField fx:id="txtCari"
                   promptText="Cari nama atau lokasi ruangan..."
                   HBox.hgrow="ALWAYS"/>

        <ComboBox fx:id="cbFilter"
          prefWidth="140"
          promptText="Filter Status"
          onAction="#onFilter"/>

        <Button onAction="#onRefresh"
                text="Segarkan"/>

        <Button onAction="#onTambah"
                text="+ Tambah Ruangan"/>

    </HBox>

    <TableView fx:id="tvRuangan" VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn fx:id="colId"
                         prefWidth="55"
                         text="ID"/>

            <TableColumn fx:id="colNama"
                         prefWidth="140"
                         text="Nama Ruangan"/>

            <TableColumn fx:id="colLokasi"
                         prefWidth="190"
                         text="Lokasi"/>

            <TableColumn fx:id="colKapasitas"
                         prefWidth="85"
                         text="Kapasitas"/>

            <TableColumn fx:id="colFasilitas"
                         prefWidth="180"
                         text="Fasilitas"/>

            <TableColumn fx:id="colStatus"
                         prefWidth="100"
                         text="Status"/>

        </columns>

        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>

    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10">

        <Button onAction="#onEdit"
                text="Edit Ruangan"/>

        <Button onAction="#onHapus"
                text="Hapus Ruangan"/>

    </HBox>

</VBox>
