<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.simaru.controller.RegisterController">
    <padding>
        <Insets bottom="18" left="18" right="18" top="18"/>
    </padding>

    <Label styleClass="judul" text="Registrasi Mahasiswa"/>
    <Label styleClass="sub-judul" text="Akun baru otomatis berperan Mahasiswa." wrapText="true"/>

    <VBox spacing="4">
        <Label text="Nama lengkap"/>
        <TextField fx:id="tfNama" promptText="Nama sesuai KTM"/>
    </VBox>
    <VBox spacing="4">
        <Label text="NIM"/>
        <TextField fx:id="tfNimNip" promptText="Contoh: 2508561002"/>
    </VBox>
    <VBox spacing="4">
        <Label text="Email"/>
        <TextField fx:id="tfEmail" promptText="nama@email.com"/>
    </VBox>
    <VBox spacing="4">
        <Label text="Program studi"/>
        <ComboBox fx:id="cbProdi" maxWidth="Infinity"/>
    </VBox>
    <VBox spacing="4">
        <Label text="Password (minimal 6 karakter)"/>
        <PasswordField fx:id="pfPassword"/>
    </VBox>
    <VBox spacing="4">
        <Label text="Konfirmasi password"/>
        <PasswordField fx:id="pfKonfirmasi"/>
    </VBox>

    <HBox spacing="8">
        <Button onAction="#onDaftar" styleClass="tombol-utama" text="Daftar"/>
        <Button onAction="#onBatal" text="Kembali ke Login"/>
    </HBox>
</VBox>
