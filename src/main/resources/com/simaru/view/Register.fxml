<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="480.0"
            style="-fx-background-color: #F4F7FB;"
            xmlns="http://javafx.com/javafx/13"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.simaru.controller.RegisterController">

    <center>
        <VBox alignment="CENTER"
              maxWidth="360.0"
              spacing="12.0"
              BorderPane.alignment="CENTER">

            <padding>
                <Insets top="25.0" right="25.0"
                        bottom="25.0" left="25.0"/>
            </padding>

            <Label text="SIMARU"
                   style="-fx-font-size: 28px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #163A5F;"/>

            <Label text="Buat Akun Baru"
                   style="-fx-font-size: 20px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #263445;"/>

            <Label text="Silakan isi data untuk mendaftar."
                   style="-fx-font-size: 12px;
                          -fx-text-fill: #718096;"/>

            <!-- Nama -->
            <VBox spacing="5.0">
                <Label text="Nama Lengkap"/>
                <TextField fx:id="namaField"
                           promptText="Masukkan nama lengkap"
                           prefHeight="38.0"/>
            </VBox>

            <!-- NIM/NIP -->
            <VBox spacing="5.0">
                <Label text="NIM / NIP"/>
                <TextField fx:id="nimNipField"
                           promptText="Masukkan NIM atau NIP"
                           prefHeight="38.0"/>
            </VBox>

            <!-- Email -->
            <VBox spacing="5.0">
                <Label text="Email"/>
                <TextField fx:id="emailField"
                           promptText="Masukkan email"
                           prefHeight="38.0"/>
            </VBox>

            <!-- Role -->
            <VBox spacing="5.0">
                <Label text="Daftar Sebagai"/>
                <ComboBox fx:id="roleComboBox"
                          promptText="Pilih peran"
                          prefHeight="38.0"
                          prefWidth="310.0"/>
            </VBox>

            <!-- Password -->
            <VBox spacing="5.0">
                <Label text="Password"/>
                <PasswordField fx:id="passwordField"
                               promptText="Masukkan password"
                               prefHeight="38.0"/>
            </VBox>

            <!-- Konfirmasi Password -->
            <VBox spacing="5.0">
                <Label text="Konfirmasi Password"/>
                <PasswordField fx:id="konfirmasiPasswordField"
                               promptText="Ulangi password"
                               prefHeight="38.0"/>
            </VBox>

            <!-- Tombol Register -->
            <Button fx:id="registerButton"
                    text="DAFTAR SEKARANG"
                    onAction="#handleRegister"
                    prefHeight="42.0"
                    maxWidth="Infinity"
                    style="-fx-background-color: #1D4ED8;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8px;
                           -fx-cursor: hand;"/>

            <!-- Kembali Login -->
            <HBox alignment="CENTER" spacing="5.0">
                <Label text="Sudah punya akun?"/>
                <Button text="Login di sini"
                        onAction="#handleBackToLogin"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #1D4ED8;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>
