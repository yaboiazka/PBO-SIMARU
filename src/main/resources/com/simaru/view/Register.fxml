<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane
    prefWidth="1000.0"
    prefHeight="680.0"
    minWidth="1000.0"
    minHeight="680.0"
    styleClass="auth-root"
    stylesheets="@../css/auth.css"
    xmlns="http://javafx.com/javafx/13"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.simaru.controller.RegisterController">

    <children>

        <HBox
            prefWidth="960.0"
            prefHeight="620.0"
            styleClass="auth-card">

            <!-- PANEL KIRI -->
            <VBox
                prefWidth="300.0"
                maxWidth="300.0"
                prefHeight="620.0"
                spacing="22"
                styleClass="auth-brand-panel">

                <padding>
                    <Insets
                        top="45"
                        right="28"
                        bottom="45"
                        left="28"/>
                </padding>

                <Label
                    text="SIMARU"
                    styleClass="auth-brand-name"/>

                <VBox spacing="12">

                    <Label
                        text="Buat Akun Baru"
                        wrapText="true"
                        styleClass="auth-brand-title"/>

                    <Label
                        text="Bergabunglah dan gunakan layanan Sistem Manajemen Ruangan dengan mudah."
                        wrapText="true"
                        styleClass="auth-brand-description"/>

                </VBox>

                <Label
                    text="Data akun Anda digunakan untuk mengakses layanan SIMARU."
                    wrapText="true"
                    styleClass="auth-brand-note"/>

            </VBox>

            <!-- PANEL KANAN -->
            <VBox
                prefWidth="660.0"
                maxWidth="660.0"
                prefHeight="620.0"
                spacing="14"
                styleClass="auth-form-panel">

                <padding>
                    <Insets
                        top="30"
                        right="34"
                        bottom="30"
                        left="34"/>
                </padding>

                <VBox spacing="5">

                    <Label
                        text="Registrasi Mahasiswa"
                        styleClass="auth-title"/>

                    <Label
                        text="Akun baru otomatis berperan Mahasiswa."
                        styleClass="auth-subtitle"/>

                </VBox>

                <!-- BARIS 1 -->
                <HBox spacing="16">

                    <VBox prefWidth="280" spacing="5">
                        <Label
                            text="Nama lengkap"
                            styleClass="auth-field-label"/>

                        <TextField
                            fx:id="tfNama"
                            promptText="Nama sesuai KTM"
                            maxWidth="Infinity"
                            styleClass="auth-input"/>
                    </VBox>

                    <VBox prefWidth="280" spacing="5">
                        <Label
                            text="NIM"
                            styleClass="auth-field-label"/>

                        <TextField
                            fx:id="tfNimNip"
                            promptText="Masukkan NIM"
                            maxWidth="Infinity"
                            styleClass="auth-input"/>
                    </VBox>

                </HBox>

                <!-- BARIS 2 -->
                <HBox spacing="16">

                    <VBox prefWidth="280" spacing="5">
                        <Label
                            text="Email"
                            styleClass="auth-field-label"/>

                        <TextField
                            fx:id="tfEmail"
                            promptText="nama@email.com"
                            maxWidth="Infinity"
                            styleClass="auth-input"/>
                    </VBox>

                    <VBox prefWidth="280" spacing="5">
                        <Label
                            text="Program studi"
                            styleClass="auth-field-label"/>

                        <ComboBox
                            fx:id="cbProdi"
                            promptText="Pilih program studi"
                            maxWidth="Infinity"
                            styleClass="auth-input"/>
                    </VBox>

                </HBox>

                <!-- BARIS 3 -->
                <HBox spacing="16">

                    <VBox prefWidth="280" spacing="5">
                        <Label
                            text="Password"
                            styleClass="auth-field-label"/>

                        <PasswordField
                            fx:id="pfPassword"
                            promptText="Minimal 6 karakter"
                            maxWidth="Infinity"
                            styleClass="auth-input"/>
                    </VBox>

                    <VBox prefWidth="280" spacing="5">
                        <Label
                            text="Konfirmasi password"
                            styleClass="auth-field-label"/>

                        <PasswordField
                            fx:id="pfKonfirmasi"
                            promptText="Ulangi password"
                            maxWidth="Infinity"
                            styleClass="auth-input"/>
                    </VBox>

                </HBox>

                <!-- TOMBOL -->
                <HBox
                    spacing="12"
                    alignment="CENTER_LEFT">

                    <Button
                        text="Daftar"
                        onAction="#onDaftar"
                        prefWidth="140"
                        styleClass="auth-primary-button"/>

                    <Button
                        text="Kembali ke Login"
                        onAction="#onBatal"
                        prefWidth="180"
                        styleClass="auth-secondary-button"/>

                </HBox>

            </VBox>

        </HBox>

    </children>

</StackPane>
