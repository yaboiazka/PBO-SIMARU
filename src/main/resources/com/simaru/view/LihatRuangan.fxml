<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.simaru.controller.LihatRuanganController">
    <fx:include source="nav.fxml"/>

    <padding>
        <Insets bottom="16" left="16" right="16" top="16" />
    </padding>

    <Label styleClass="judul" text="Ketersediaan Ruangan" />

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Filter status" />
        <ComboBox fx:id="cbFilter" onAction="#onFilter" />
        <Button onAction="#onFilter" text="Segarkan" />
    </HBox>

    <TableView fx:id="tvRuangan" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNama" prefWidth="140" text="Nama Ruangan" />
            <TableColumn fx:id="colLokasi" prefWidth="210" text="Lokasi" />
            <TableColumn fx:id="colKapasitas" prefWidth="80" text="Kapasitas" />
            <TableColumn fx:id="colFasilitas" prefWidth="240" text="Fasilitas" />
            <TableColumn fx:id="colStatus" prefWidth="90" text="Status" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
</VBox>
