<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="560.0"
           prefWidth="520.0"
           styleClass="login-root"
           xmlns="http://javafx.com/javafx/26"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.simaru.controller.loginController">

    <VBox alignment="CENTER_LEFT"
          maxWidth="360.0"
          prefWidth="360.0"
          spacing="15"
          styleClass="login-card">

        <padding>
            <Insets top="32" bottom="32" left="30" right="30"/>
        </padding>

        <Label text="SIMARU"
               styleClass="login-brand"/>

        <VBox spacing="5">
            <Label text="Selamat Datang!"
                   styleClass="login-title"/>

            <Label text="Masuk untuk melanjutkan ke Sistem Manajemen Ruangan."
                   wrapText="true"
                   styleClass="login-subtitle"/>
        </VBox>

        <VBox spacing="7">
            <Label text="Email"
                   styleClass="login-label"/>

            <TextField fx:id="emailArea"
                       promptText="Masukkan email Anda"
                       maxWidth="Infinity"
                       prefHeight="42"
                       styleClass="login-field"/>
        </VBox>

        <VBox spacing="7">
            <Label text="Password"
                   styleClass="login-label"/>

            <PasswordField fx:id="passwordArea"
                           promptText="Masukkan password Anda"
                           maxWidth="Infinity"
                           prefHeight="42"
                           styleClass="login-field"/>
        </VBox>

        <HBox spacing="12"
              alignment="CENTER"
              fillHeight="true">

            <Button fx:id="loginButton"
                    text="Login"
                    onAction="#handleLogin"
                    maxWidth="Infinity"
                    prefHeight="42"
                    HBox.hgrow="ALWAYS"
                    styleClass="login-primary"/>

            <Button text="Register"
                    onAction="#handleRegister"
                    maxWidth="Infinity"
                    prefHeight="42"
                    HBox.hgrow="ALWAYS"
                    styleClass="login-secondary"/>

        </HBox>

        <Label text="SIMARU • Sistem Manajemen Ruangan"
               styleClass="login-footer"/>

    </VBox>

</StackPane>
