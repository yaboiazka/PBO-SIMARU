<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="root" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.simaru.controller.DashboardAdminController">
    <left>
        <VBox prefWidth="220" spacing="4" styleClass="sidebar">
            <padding>
                <Insets bottom="16" left="12" right="12" top="16" />
            </padding>
            <Label styleClass="sidebar-judul" text="SIMARU">
            <font>
               <Font name="System Bold Italic" size="24.0" />
            </font></Label>
            <Label fx:id="lblNama" text="Admin" />
            <Label styleClass="sub-judul" text="Admin" />
            <Region prefHeight="16" />
            <Button maxWidth="Infinity" onAction="#onVerifikasi" styleClass="menu-button" text="Verifikasi Peminjaman" />
            <Button maxWidth="Infinity" onAction="#onJadwal" styleClass="menu-button" text="Lihat Jadwal" />
            <Button maxWidth="Infinity" onAction="#onKelolaRuangan" styleClass="menu-button" text="Kelola Ruangan" />
            <Button maxWidth="Infinity" onAction="#onKelolaPengguna" styleClass="menu-button" text="Kelola Pengguna" />
            <Button maxWidth="Infinity" onAction="#onLaporan" styleClass="menu-button" text="Laporan Penggunaan" />
            <Region VBox.vgrow="ALWAYS" />
            <Button maxWidth="Infinity" onAction="#onLogout" styleClass="menu-button" text="Logout" />
        </VBox>
    </left>
</BorderPane>
