<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" stylesheets="@../css/dashboard.css, @../css/status.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.simaru.controller.KelolaPenggunaController">
    <padding>
        <Insets bottom="16" left="16" right="16" top="16"/>
    </padding>

    <Label styleClass="judul" text="Kelola Pengguna"/>
    <Label styleClass="sub-judul" text="Password dikosongkan saat mengubah berarti password lama tidak diganti."/>

    <TableView fx:id="tvPengguna" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNama" prefWidth="170" text="Nama"/>
            <TableColumn fx:id="colNimNip" prefWidth="120" text="NIM/NIP"/>
            <TableColumn fx:id="colEmail" prefWidth="200" text="Email"/>
            <TableColumn fx:id="colRole" prefWidth="90" text="Peran"/>
            <TableColumn fx:id="colProdi" prefWidth="160" text="Program Studi"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <GridPane hgap="10" vgap="8">
        <Label text="Nama" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="tfNama" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="NIM/NIP" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <TextField fx:id="tfNimNip" prefWidth="160" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
        <Label text="Email" GridPane.columnIndex="4" GridPane.rowIndex="0"/>
        <TextField fx:id="tfEmail" prefWidth="200" GridPane.columnIndex="5" GridPane.rowIndex="0"/>

        <Label text="Peran" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <ComboBox fx:id="cbRole" prefWidth="130" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Program Studi" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <ComboBox fx:id="cbProdi" prefWidth="200" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
        <Label text="Password" GridPane.columnIndex="4" GridPane.rowIndex="1"/>
        <PasswordField fx:id="pfPassword" prefWidth="200" GridPane.columnIndex="5" GridPane.rowIndex="1"/>
    </GridPane>

    <HBox spacing="8">
        <Button onAction="#onTambah" styleClass="tombol-utama" text="Tambah"/>
        <Button onAction="#onUbah" text="Ubah"/>
        <Button onAction="#onHapus" styleClass="tombol-bahaya" text="Hapus"/>
        <Button onAction="#onBersihkan" text="Bersihkan Form"/>
    </HBox>
</VBox>
