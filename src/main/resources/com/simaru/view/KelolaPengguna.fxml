<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.simaru.controller.KelolaPenggunaController">

    <padding>
        <Insets bottom="16" left="16" right="16" top="16"/>
    </padding>

    <Label styleClass="judul" text="Kelola Pengguna"/>

    <Label text="Manajemen data Admin, Dosen, dan Mahasiswa SIMARU"/>

    <HBox alignment="CENTER_LEFT" spacing="10">

        <TextField fx:id="txtCari"
                   promptText="Cari nama, NIM/NIP, atau email..."
                   HBox.hgrow="ALWAYS"/>

        <ComboBox fx:id="cbFilter"
                  prefWidth="150"
                  promptText="Filter Role"
                  onAction="#onFilter"/>

        <Button onAction="#onRefresh"
                text="Segarkan"/>

        <Button onAction="#onTambah"
                styleClass="tombol-utama"
                text="+ Tambah Pengguna"/>
    </HBox>

    <TableView fx:id="tvPengguna" VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn fx:id="colId"
                         prefWidth="55"
                         text="ID"/>

            <TableColumn fx:id="colNama"
                         prefWidth="150"
                         text="Nama"/>

            <TableColumn fx:id="colNimNip"
                         prefWidth="120"
                         text="NIM/NIP"/>

            <TableColumn fx:id="colEmail"
                         prefWidth="180"
                         text="Email"/>

            <TableColumn fx:id="colRole"
                         prefWidth="110"
                         text="Role"/>

            <TableColumn fx:id="colProgramStudi"
                         prefWidth="180"
                         text="Fakultas / Program Studi"/>

        </columns>

        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>

    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10">

        <Button onAction="#onEdit"
                styleClass="tombol-utama"
                text="Edit Pengguna"/>
        <Button onAction="#onHapus"
                styleClass="tombol-bahaya"
                text="Hapus Pengguna"/>
    </HBox>

</VBox>
