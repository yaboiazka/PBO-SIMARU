<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.simaru.controller.VerifikasiPeminjamanController">
    <padding>
        <Insets bottom="12" left="12" right="12" top="12"/>
    </padding>

    <Label styleClass="judul" text="Verifikasi Peminjaman"/>
    <Label styleClass="sub-judul"
           text="Pilih pengajuan untuk melihat detail dan pemeriksaan bentrok jadwal."
           wrapText="true"/>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <Tab fx:id="tabMenunggu" text="Menunggu Verifikasi">
            <content>
                <HBox spacing="12">
                    <TableView fx:id="tvMenunggu" HBox.hgrow="ALWAYS" prefWidth="620">
                        <columns>
                            <TableColumn fx:id="colMNo" prefWidth="45" text="No."/>
                            <TableColumn fx:id="colMPemohon" prefWidth="150" text="Pemohon"/>
                            <TableColumn fx:id="colMPeran" prefWidth="80" text="Peran"/>
                            <TableColumn fx:id="colMRuangan" prefWidth="110" text="Ruangan"/>
                            <TableColumn fx:id="colMTanggal" prefWidth="90" text="Tanggal"/>
                            <TableColumn fx:id="colMJam" prefWidth="105" text="Jam"/>
                            <TableColumn fx:id="colMKeperluan" prefWidth="150" text="Keperluan"/>
                            <TableColumn fx:id="colMDiajukan" prefWidth="125" text="Diajukan Pada"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <VBox prefWidth="380" spacing="10" styleClass="card">
                        <Label text="Detail Pengajuan"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                        <GridPane hgap="12" vgap="8">
                            <Label text="Pemohon" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <Label fx:id="lblDPemohon" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            <Label text="NIM/NIP" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <Label fx:id="lblDIdentitas" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            <Label text="Ruangan" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <Label fx:id="lblDRuangan" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                            <Label text="Kapasitas" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                            <Label fx:id="lblDKapasitas" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                            <Label text="Tanggal" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                            <Label fx:id="lblDTanggal" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                            <Label text="Jam" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                            <Label fx:id="lblDJam" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                            <Label text="Keperluan" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                            <Label fx:id="lblDKeperluan" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                            <Label text="Status Ruangan" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                            <Label fx:id="lblDStatusRuangan" GridPane.columnIndex="1" GridPane.rowIndex="7"/>
                        </GridPane>

                        <Label fx:id="lblBentrok" styleClass="peringatan" wrapText="true"/>

                        <Label text="Catatan (wajib saat menolak)"/>
                        <TextArea fx:id="taCatatan" prefRowCount="3" wrapText="true"/>

                        <HBox spacing="8">
                            <Button fx:id="btnTolak" onAction="#onTolak" styleClass="tombol-bahaya"
                                    text="Tolak"/>
                            <Button fx:id="btnSetujui" onAction="#onSetujui" styleClass="tombol-utama"
                                    text="Setujui"/>
                        </HBox>
                    </VBox>
                </HBox>
            </content>
        </Tab>

        <Tab fx:id="tabRiwayat" text="Riwayat Verifikasi">
            <content>
                <VBox spacing="8">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Filter status"/>
                        <ComboBox fx:id="cbRiwayat" prefWidth="140"/>
                        <Button onAction="#onSegarkan" text="Muat Ulang"/>
                    </HBox>
                    <TableView fx:id="tvRiwayat" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colRNo" prefWidth="45" text="No."/>
                            <TableColumn fx:id="colRPemohon" prefWidth="150" text="Pemohon"/>
                            <TableColumn fx:id="colRRuangan" prefWidth="110" text="Ruangan"/>
                            <TableColumn fx:id="colRTanggal" prefWidth="90" text="Tanggal"/>
                            <TableColumn fx:id="colRJam" prefWidth="105" text="Jam"/>
                            <TableColumn fx:id="colRStatus" prefWidth="90" text="Status"/>
                            <TableColumn fx:id="colRAdmin" prefWidth="130" text="Diverifikasi Oleh"/>
                            <TableColumn fx:id="colRCatatan" prefWidth="180" text="Catatan"/>
                            <TableColumn fx:id="colRWaktu" prefWidth="130" text="Waktu Verifikasi"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </content>
        </Tab>
    </TabPane>
</VBox>
