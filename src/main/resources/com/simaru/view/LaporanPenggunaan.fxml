<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.simaru.controller.LaporanPenggunaanController">
    <padding>
        <Insets bottom="16" left="16" right="16" top="16"/>
    </padding>

    <Label styleClass="judul" text="Laporan Penggunaan Ruangan"/>
    <Label styleClass="sub-judul"
           text="Periode dihitung berdasarkan tanggal pemakaian ruangan (tanggal pinjam)."
           wrapText="true"/>

    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label text="Dari"/>
        <DatePicker fx:id="dpDari" prefWidth="130"/>
        <Label text="Sampai"/>
        <DatePicker fx:id="dpSampai" prefWidth="130"/>
        <Label text="Ruangan"/>
        <ComboBox fx:id="cbRuangan" prefWidth="160"/>
        <Label text="Status"/>
        <ComboBox fx:id="cbStatus" prefWidth="120"/>
        <Button onAction="#onTampilkan" styleClass="tombol-utama" text="Tampilkan"/>
        <Button onAction="#onCetak" text="Cetak"/>
        <Button onAction="#onEkspor" text="Ekspor CSV"/>
    </HBox>

    <HBox spacing="18">
        <Label fx:id="lblTotalPengajuan" styleClass="ringkasan" text="Total pengajuan: 0"/>
        <Label fx:id="lblDisetujui" styleClass="ringkasan" text="Disetujui: 0"/>
        <Label fx:id="lblDitolak" styleClass="ringkasan" text="Ditolak: 0"/>
        <Label fx:id="lblJamTerpakai" styleClass="ringkasan" text="Jam terpakai: 0,00"/>
    </HBox>

    <Label styleClass="sub-judul" text="Ringkasan per Ruangan"/>
    <TableView fx:id="tvRingkasan" prefHeight="150">
        <columns>
            <TableColumn fx:id="colRNama" prefWidth="170" text="Ruangan"/>
            <TableColumn fx:id="colRTotal" prefWidth="100" text="Pengajuan"/>
            <TableColumn fx:id="colRSetuju" prefWidth="90" text="Disetujui"/>
            <TableColumn fx:id="colRDitolak" prefWidth="80" text="Ditolak"/>
            <TableColumn fx:id="colRPending" prefWidth="80" text="Pending"/>
            <TableColumn fx:id="colRJam" prefWidth="110" text="Jam Terpakai"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <Label styleClass="sub-judul" text="Rincian Peminjaman"/>
    <TableView fx:id="tvRincian" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNo" prefWidth="45" text="No."/>
            <TableColumn fx:id="colRuangan" prefWidth="110" text="Ruangan"/>
            <TableColumn fx:id="colPeminjam" prefWidth="150" text="Peminjam"/>
            <TableColumn fx:id="colPeran" prefWidth="85" text="Peran"/>
            <TableColumn fx:id="colTanggal" prefWidth="90" text="Tanggal"/>
            <TableColumn fx:id="colJam" prefWidth="105" text="Jam"/>
            <TableColumn fx:id="colKeperluan" prefWidth="180" text="Keperluan"/>
            <TableColumn fx:id="colStatus" prefWidth="90" text="Status"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
</VBox>
