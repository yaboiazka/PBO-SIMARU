<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.simaru.controller.LihatJadwalController">
      
    <fx:include source="nav.fxml"/>
    <padding>
        <Insets bottom="16" left="16" right="16" top="16"/>
    </padding>

    <Label styleClass="judul" text="Jadwal Penggunaan Ruangan"/>
    <Label styleClass="sub-judul" text="Hanya menampilkan peminjaman yang sudah disetujui."/>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Tanggal"/>
        <DatePicker fx:id="dpTanggal"/>
        <Button onAction="#onTampilkan" styleClass="tombol-utama" text="Tampilkan"/>
        <Button onAction="#onSemua" text="Semua Tanggal"/>
    </HBox>

    <TableView fx:id="tvJadwal" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colRuangan" prefWidth="110" text="Ruangan"/>
            <TableColumn fx:id="colTanggal" prefWidth="95" text="Tanggal"/>
            <TableColumn fx:id="colJam" prefWidth="110" text="Jam"/>
            <TableColumn fx:id="colPengguna" prefWidth="170" text="Dipakai oleh"/>
            <TableColumn fx:id="colKeperluan" prefWidth="200" text="Keperluan"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
</VBox>
