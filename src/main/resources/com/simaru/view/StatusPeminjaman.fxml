<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.simaru.controller.StatusPeminjamanController">
    <padding>
        <Insets bottom="16" left="16" right="16" top="16"/>
    </padding>

    <Label styleClass="judul" text="Status Peminjaman Saya"/>
    <Label styleClass="sub-judul" text="Pantau tahap persetujuan dan batalkan pengajuan yang masih Pending."
           wrapText="true"/>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Status"/>
        <ComboBox fx:id="cbFilter" prefWidth="140"/>
        <Button onAction="#onSegarkan" text="Muat Ulang"/>
        <Label fx:id="lblRingkasan" styleClass="ringkasan"/>
    </HBox>

    <TableView fx:id="tvPeminjaman" prefHeight="260" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="45" text="No."/>
            <TableColumn fx:id="colRuangan" prefWidth="110" text="Ruangan"/>
            <TableColumn fx:id="colLokasi" prefWidth="160" text="Lokasi"/>
            <TableColumn fx:id="colTanggal" prefWidth="90" text="Tanggal"/>
            <TableColumn fx:id="colJam" prefWidth="105" text="Jam"/>
            <TableColumn fx:id="colKeperluan" prefWidth="170" text="Keperluan"/>
            <TableColumn fx:id="colStatus" prefWidth="90" text="Status"/>
            <TableColumn fx:id="colCatatan" prefWidth="170" text="Catatan Admin"/>
            <TableColumn fx:id="colDiajukan" prefWidth="130" text="Diajukan Pada"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <Label styleClass="sub-judul" text="Detail Pengajuan"/>
    <GridPane hgap="14" vgap="6">
        <Label text="Ruangan" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <Label fx:id="lblDRuangan" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Lokasi" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <Label fx:id="lblDLokasi" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

        <Label text="Tanggal" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <Label fx:id="lblDTanggal" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Jam" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <Label fx:id="lblDJam" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

        <Label text="Keperluan" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <Label fx:id="lblDKeperluan" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Label text="Status" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
        <Label fx:id="lblDStatus" GridPane.columnIndex="3" GridPane.rowIndex="2"/>

        <Label text="Catatan Admin" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <Label fx:id="lblDCatatan" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        <Label text="Diverifikasi oleh" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
        <Label fx:id="lblDAdmin" GridPane.columnIndex="3" GridPane.rowIndex="3"/>

        <Label text="Waktu Verifikasi" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <Label fx:id="lblDWaktuVerifikasi" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
    </GridPane>

    <HBox spacing="8">
        <Button fx:id="btnBatalkan" onAction="#onBatalkan" styleClass="tombol-bahaya"
                text="Batalkan Pengajuan"/>
        <Button onAction="#onSegarkan" text="Muat Ulang"/>
    </HBox>
</VBox>
