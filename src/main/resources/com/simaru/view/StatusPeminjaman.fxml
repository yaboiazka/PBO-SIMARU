<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.simaru.controller.StatusPeminjamanController">
    <padding>
        <Insets bottom="16" left="16" right="16" top="16"/>
    </padding>

    <Label styleClass="judul" text="Status Peminjaman Saya"/>

    <TableView fx:id="tvPeminjaman" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="45" text="ID"/>
            <TableColumn fx:id="colRuangan" prefWidth="110" text="Ruangan"/>
            <TableColumn fx:id="colTanggal" prefWidth="95" text="Tanggal"/>
            <TableColumn fx:id="colJam" prefWidth="110" text="Jam"/>
            <TableColumn fx:id="colKeperluan" prefWidth="170" text="Keperluan"/>
            <TableColumn fx:id="colStatus" prefWidth="80" text="Status"/>
            <TableColumn fx:id="colCatatan" prefWidth="180" text="Catatan Admin"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox spacing="8">
        <Button onAction="#onBatalkan" styleClass="tombol-bahaya" text="Batalkan Pengajuan"/>
        <Button onAction="#onSegarkan" text="Segarkan"/>
    </HBox>
</VBox>
